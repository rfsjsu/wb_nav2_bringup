<?xml version="1.0"?>
<sdf version="1.6" xmlns:xacro="http://www.ros.org/wiki/xacro" xmlns:experimental="http://sdformat.org/schemas/experimental">
  <xacro:arg name="headless" default="true"/>
  <world name="mission_depot_v2">
    <!-- Overhead view -->
    <gui>
      <camera name='user_camera'>
        <pose>0 0 10 3.1415926535897931 1.5707926536359933 3.1415926535897931</pose>
      </camera>
    </gui>
    <scene>
      <grid>false</grid>
      <ambient>0.400000006 0.400000006 0.400000006 1</ambient>
      <background>0.699999988 0.699999988 0.699999988 1</background>
      <shadows>true</shadows>
    </scene>
    <physics name="1ms" type="ode">
      <max_step_size>0.003</max_step_size>
      <real_time_update_rate>1000.0</real_time_update_rate>
      <real_time_factor>1.0</real_time_factor>
    </physics>

    <plugin
      filename="gz-sim-physics-system"
      name="gz::sim::systems::Physics">
    </plugin>
    <plugin
      filename="gz-sim-user-commands-system"
      name="gz::sim::systems::UserCommands">
    </plugin>
  <xacro:unless value="$(arg headless)">
    <plugin
      filename="gz-sim-scene-broadcaster-system"
      name="gz::sim::systems::SceneBroadcaster">
    </plugin>
  </xacro:unless>
    <plugin
      filename="gz-sim-sensors-system"
      name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>
    <plugin
      filename="gz-sim-imu-system"
      name="gz::sim::systems::Imu">
    </plugin>

    <include>
      <uri>
        https://fuel.gazebosim.org/1.0/OpenRobotics/models/Depot
      </uri>

      <!-- Remove annoying things that get in the way of visualizing the robot -->
      <experimental:params>
        <visual element_id="Fan1::visual" action="remove"/>
        <visual element_id="Fan2::visual" action="remove"/>
        <visual element_id="main::ROOF_visual" action="remove"/>
        <visual element_id="main::FANS_visual" action="remove"/>
      </experimental:params>

    </include>
    <!-- Home position marker -->
    <model name="home_marker">
      <static>true</static>
      <pose>-2.0 0.0 0.001 0 0 0</pose>
      <link name="link">
        <!-- top edge -->
        <visual name="top">
          <pose>0 1.5 0 0 0 0</pose>
          <geometry><box><size>3.0 0.1 0.001</size></box></geometry>
          <material><ambient>1 0 0 1</ambient><diffuse>1 0 0 1</diffuse></material>
        </visual>
        <!-- bottom edge -->
        <visual name="bottom">
          <pose>0 -1.5 0 0 0 0</pose>
          <geometry><box><size>3.0 0.1 0.001</size></box></geometry>
          <material><ambient>1 0 0 1</ambient><diffuse>1 0 0 1</diffuse></material>
        </visual>
        <!-- left edge -->
        <visual name="left">
          <pose>-1.5 0 0 0 0 0</pose>
          <geometry><box><size>0.1 3.0 0.001</size></box></geometry>
          <material><ambient>1 0 0 1</ambient><diffuse>1 0 0 1</diffuse></material>
        </visual>
        <!-- right edge -->
        <visual name="right">
          <pose>1.5 0 0 0 0 0</pose>
          <geometry><box><size>0.1 3.0 0.001</size></box></geometry>
          <material><ambient>1 0 0 1</ambient><diffuse>1 0 0 1</diffuse></material>
        </visual>
        <!-- center line -->
        <visual name="center_line">
          <pose>-6 0 0 0 0 0</pose>
          <geometry><box><size>12.0 0.02 0.001</size></box></geometry>
          <material><ambient>1 0 0 1</ambient><diffuse>1 0 0 1</diffuse></material>
        </visual>
        <!-- S -->
        <visual name="s_top"><pose>0 -2.3 0 0 0 0</pose><geometry><box><size>1.0 0.16 0.001</size></box></geometry><material><ambient>1 0 0 1</ambient><diffuse>1 0 0 1</diffuse></material></visual>
        <visual name="s_mid"><pose>0 -2.7 0 0 0 0</pose><geometry><box><size>1.0 0.16 0.001</size></box></geometry><material><ambient>1 0 0 1</ambient><diffuse>1 0 0 1</diffuse></material></visual>
        <visual name="s_bot"><pose>0 -3.1 0 0 0 0</pose><geometry><box><size>1.0 0.16 0.001</size></box></geometry><material><ambient>1 0 0 1</ambient><diffuse>1 0 0 1</diffuse></material></visual>
        <visual name="s_tl"><pose>-0.42 -2.5 0 0 0 0</pose><geometry><box><size>0.16 0.4 0.001</size></box></geometry><material><ambient>1 0 0 1</ambient><diffuse>1 0 0 1</diffuse></material></visual>
        <visual name="s_br"><pose>0.42 -2.9 0 0 0 0</pose><geometry><box><size>0.16 0.4 0.001</size></box></geometry><material><ambient>1 0 0 1</ambient><diffuse>1 0 0 1</diffuse></material></visual>
      </link>
    </model>

    <!-- D2 zone marker -->
    <model name="d2_zone_marker">
      <static>true</static>
      <pose>-5 5.5 0.001 0 0 0</pose>
      <link name="link">
        <visual name="top"><pose>0 1.0 0 0 0 0</pose><geometry><box><size>2.0 0.08 0.001</size></box></geometry><material><ambient>0 1 0 1</ambient><diffuse>0 1 0 1</diffuse></material></visual>
        <visual name="bottom"><pose>0 -1.0 0 0 0 0</pose><geometry><box><size>2.0 0.08 0.001</size></box></geometry><material><ambient>0 1 0 1</ambient><diffuse>0 1 0 1</diffuse></material></visual>
        <visual name="left"><pose>-1.0 0 0 0 0 0</pose><geometry><box><size>0.08 2.0 0.001</size></box></geometry><material><ambient>0 1 0 1</ambient><diffuse>0 1 0 1</diffuse></material></visual>
        <visual name="right"><pose>1.0 0 0 0 0 0</pose><geometry><box><size>0.08 2.0 0.001</size></box></geometry><material><ambient>0 1 0 1</ambient><diffuse>0 1 0 1</diffuse></material></visual>
        <!-- D -->
        <visual name="d_left"><pose>1.3 0 0 0 0 0</pose><geometry><box><size>0.08 0.6 0.001</size></box></geometry><material><ambient>0 1 0 1</ambient><diffuse>0 1 0 1</diffuse></material></visual>
        <visual name="d_top"><pose>1.5 0.25 0 0 0 0</pose><geometry><box><size>0.3 0.08 0.001</size></box></geometry><material><ambient>0 1 0 1</ambient><diffuse>0 1 0 1</diffuse></material></visual>
        <visual name="d_bot"><pose>1.5 -0.25 0 0 0 0</pose><geometry><box><size>0.3 0.08 0.001</size></box></geometry><material><ambient>0 1 0 1</ambient><diffuse>0 1 0 1</diffuse></material></visual>
        <visual name="d_tr"><pose>1.72 0.17 0 0 0 0</pose><geometry><box><size>0.08 0.2 0.001</size></box></geometry><material><ambient>0 1 0 1</ambient><diffuse>0 1 0 1</diffuse></material></visual>
        <visual name="d_br"><pose>1.72 -0.17 0 0 0 0</pose><geometry><box><size>0.08 0.2 0.001</size></box></geometry><material><ambient>0 1 0 1</ambient><diffuse>0 1 0 1</diffuse></material></visual>
        <visual name="d_mid"><pose>1.78 0 0 0 0 0</pose><geometry><box><size>0.08 0.1 0.001</size></box></geometry><material><ambient>0 1 0 1</ambient><diffuse>0 1 0 1</diffuse></material></visual>
        <!-- 2 -->
        <visual name="two_top"><pose>2.15 0.25 0 0 0 0</pose><geometry><box><size>0.3 0.08 0.001</size></box></geometry><material><ambient>0 1 0 1</ambient><diffuse>0 1 0 1</diffuse></material></visual>
        <visual name="two_mid"><pose>2.15 0 0 0 0 0</pose><geometry><box><size>0.3 0.08 0.001</size></box></geometry><material><ambient>0 1 0 1</ambient><diffuse>0 1 0 1</diffuse></material></visual>
        <visual name="two_bot"><pose>2.15 -0.25 0 0 0 0</pose><geometry><box><size>0.3 0.08 0.001</size></box></geometry><material><ambient>0 1 0 1</ambient><diffuse>0 1 0 1</diffuse></material></visual>
        <visual name="two_tr"><pose>2.27 0.13 0 0 0 0</pose><geometry><box><size>0.08 0.2 0.001</size></box></geometry><material><ambient>0 1 0 1</ambient><diffuse>0 1 0 1</diffuse></material></visual>
        <visual name="two_bl"><pose>2.03 -0.13 0 0 0 0</pose><geometry><box><size>0.08 0.2 0.001</size></box></geometry><material><ambient>0 1 0 1</ambient><diffuse>0 1 0 1</diffuse></material></visual>
      </link>
    </model>

    <!-- D1 zone marker -->
    <model name="d1_zone_marker">
      <static>true</static>
      <pose>-5 -5.5 0.001 0 0 0</pose>
      <link name="link">
        <visual name="top"><pose>0 1.0 0 0 0 0</pose><geometry><box><size>2.0 0.08 0.001</size></box></geometry><material><ambient>0 1 0 1</ambient><diffuse>0 1 0 1</diffuse></material></visual>
        <visual name="bottom"><pose>0 -1.0 0 0 0 0</pose><geometry><box><size>2.0 0.08 0.001</size></box></geometry><material><ambient>0 1 0 1</ambient><diffuse>0 1 0 1</diffuse></material></visual>
        <visual name="left"><pose>-1.0 0 0 0 0 0</pose><geometry><box><size>0.08 2.0 0.001</size></box></geometry><material><ambient>0 1 0 1</ambient><diffuse>0 1 0 1</diffuse></material></visual>
        <visual name="right"><pose>1.0 0 0 0 0 0</pose><geometry><box><size>0.08 2.0 0.001</size></box></geometry><material><ambient>0 1 0 1</ambient><diffuse>0 1 0 1</diffuse></material></visual>
        <!-- D -->
        <visual name="d_left"><pose>1.3 0 0 0 0 0</pose><geometry><box><size>0.08 0.6 0.001</size></box></geometry><material><ambient>0 1 0 1</ambient><diffuse>0 1 0 1</diffuse></material></visual>
        <visual name="d_top"><pose>1.5 0.25 0 0 0 0</pose><geometry><box><size>0.3 0.08 0.001</size></box></geometry><material><ambient>0 1 0 1</ambient><diffuse>0 1 0 1</diffuse></material></visual>
        <visual name="d_bot"><pose>1.5 -0.25 0 0 0 0</pose><geometry><box><size>0.3 0.08 0.001</size></box></geometry><material><ambient>0 1 0 1</ambient><diffuse>0 1 0 1</diffuse></material></visual>
        <visual name="d_tr"><pose>1.72 0.17 0 0 0 0</pose><geometry><box><size>0.08 0.2 0.001</size></box></geometry><material><ambient>0 1 0 1</ambient><diffuse>0 1 0 1</diffuse></material></visual>
        <visual name="d_br"><pose>1.72 -0.17 0 0 0 0</pose><geometry><box><size>0.08 0.2 0.001</size></box></geometry><material><ambient>0 1 0 1</ambient><diffuse>0 1 0 1</diffuse></material></visual>
        <visual name="d_mid"><pose>1.78 0 0 0 0 0</pose><geometry><box><size>0.08 0.1 0.001</size></box></geometry><material><ambient>0 1 0 1</ambient><diffuse>0 1 0 1</diffuse></material></visual>
        <!-- 1 -->
        <visual name="one_v"><pose>2.1 0 0 0 0 0</pose><geometry><box><size>0.08 0.6 0.001</size></box></geometry><material><ambient>0 1 0 1</ambient><diffuse>0 1 0 1</diffuse></material></visual>
        <visual name="one_tl"><pose>1.98 0.25 0 0 0 0</pose><geometry><box><size>0.16 0.08 0.001</size></box></geometry><material><ambient>0 1 0 1</ambient><diffuse>0 1 0 1</diffuse></material></visual>
      </link>
    </model>

    <!-- Pallet 1 marker -->
    <model name="pallet_1_marker">
      <static>true</static>
      <pose>-10 -6 0.001 0 0 0</pose>
      <link name="link">
        <!-- top edge -->
        <visual name="top">
          <pose>0 0.6 0 0 0 0</pose>
          <geometry><box><size>1.6 0.08 0.001</size></box></geometry>
          <material><ambient>0 0 1 1</ambient><diffuse>0 0 1 1</diffuse></material>
        </visual>
        <!-- bottom edge -->
        <visual name="bottom">
          <pose>0 -0.6 0 0 0 0</pose>
          <geometry><box><size>1.6 0.08 0.001</size></box></geometry>
          <material><ambient>0 0 1 1</ambient><diffuse>0 0 1 1</diffuse></material>
        </visual>
        <!-- left edge -->
        <visual name="left">
          <pose>-0.8 0 0 0 0 0</pose>
          <geometry><box><size>0.08 1.2 0.001</size></box></geometry>
          <material><ambient>0 0 1 1</ambient><diffuse>0 0 1 1</diffuse></material>
        </visual>
        <!-- right edge -->
        <visual name="right">
          <pose>0.8 0 0 0 0 0</pose>
          <geometry><box><size>0.08 1.2 0.001</size></box></geometry>
          <material><ambient>0 0 1 1</ambient><diffuse>0 0 1 1</diffuse></material>
        </visual>
        <!-- P -->
        <visual name="p_left"><pose>1.2 0.1 0 0 0 0</pose><geometry><box><size>0.08 0.6 0.001</size></box></geometry><material><ambient>0 0 1 1</ambient><diffuse>0 0 1 1</diffuse></material></visual>
        <visual name="p_top"><pose>1.35 0.3 0 0 0 0</pose><geometry><box><size>0.22 0.08 0.001</size></box></geometry><material><ambient>0 0 1 1</ambient><diffuse>0 0 1 1</diffuse></material></visual>
        <visual name="p_mid"><pose>1.35 0.1 0 0 0 0</pose><geometry><box><size>0.22 0.08 0.001</size></box></geometry><material><ambient>0 0 1 1</ambient><diffuse>0 0 1 1</diffuse></material></visual>
        <visual name="p_right"><pose>1.5 0.2 0 0 0 0</pose><geometry><box><size>0.08 0.28 0.001</size></box></geometry><material><ambient>0 0 1 1</ambient><diffuse>0 0 1 1</diffuse></material></visual>
        <!-- 1 -->
        <visual name="one_vertical"><pose>1.8 0.1 0 0 0 0</pose><geometry><box><size>0.08 0.6 0.001</size></box></geometry><material><ambient>0 0 1 1</ambient><diffuse>0 0 1 1</diffuse></material></visual>
        <visual name="one_top_left"><pose>1.68 0.3 0 0 0 0</pose><geometry><box><size>0.16 0.08 0.001</size></box></geometry><material><ambient>0 0 1 1</ambient><diffuse>0 0 1 1</diffuse></material></visual>
      </link>
    </model>
    <include>
      <uri>model://pallet</uri>
      <name>pallet_1</name>
      <pose>-10 -6 0.01 0 0 0</pose> 
    </include>

    <!-- Wooden Pallet, lower back wall -->
    <!-- Pallet 2 marker -->
    <model name="pallet_2_marker">
      <static>true</static>
      <pose>-14 -3 0.001 0 0 0</pose>
      <link name="link">
        <visual name="top"><pose>0 0.6 0 0 0 0</pose><geometry><box><size>1.6 0.08 0.001</size></box></geometry><material><ambient>0 0 1 1</ambient><diffuse>0 0 1 1</diffuse></material></visual>
        <visual name="bottom"><pose>0 -0.6 0 0 0 0</pose><geometry><box><size>1.6 0.08 0.001</size></box></geometry><material><ambient>0 0 1 1</ambient><diffuse>0 0 1 1</diffuse></material></visual>
        <visual name="left"><pose>-0.8 0 0 0 0 0</pose><geometry><box><size>0.08 1.2 0.001</size></box></geometry><material><ambient>0 0 1 1</ambient><diffuse>0 0 1 1</diffuse></material></visual>
        <visual name="right"><pose>0.8 0 0 0 0 0</pose><geometry><box><size>0.08 1.2 0.001</size></box></geometry><material><ambient>0 0 1 1</ambient><diffuse>0 0 1 1</diffuse></material></visual>
        <visual name="p_left"><pose>1.2 0.1 0 0 0 0</pose><geometry><box><size>0.08 0.6 0.001</size></box></geometry><material><ambient>0 0 1 1</ambient><diffuse>0 0 1 1</diffuse></material></visual>
        <visual name="p_top"><pose>1.35 0.3 0 0 0 0</pose><geometry><box><size>0.22 0.08 0.001</size></box></geometry><material><ambient>0 0 1 1</ambient><diffuse>0 0 1 1</diffuse></material></visual>
        <visual name="p_mid"><pose>1.35 0.1 0 0 0 0</pose><geometry><box><size>0.22 0.08 0.001</size></box></geometry><material><ambient>0 0 1 1</ambient><diffuse>0 0 1 1</diffuse></material></visual>
        <visual name="p_right"><pose>1.5 0.2 0 0 0 0</pose><geometry><box><size>0.08 0.28 0.001</size></box></geometry><material><ambient>0 0 1 1</ambient><diffuse>0 0 1 1</diffuse></material></visual>
        <visual name="two_top"><pose>1.8 0.3 0 0 0 0</pose><geometry><box><size>0.3 0.08 0.001</size></box></geometry><material><ambient>0 0 1 1</ambient><diffuse>0 0 1 1</diffuse></material></visual>
        <visual name="two_mid"><pose>1.8 0.1 0 0 0 0</pose><geometry><box><size>0.3 0.08 0.001</size></box></geometry><material><ambient>0 0 1 1</ambient><diffuse>0 0 1 1</diffuse></material></visual>
        <visual name="two_bot"><pose>1.8 -0.1 0 0 0 0</pose><geometry><box><size>0.3 0.08 0.001</size></box></geometry><material><ambient>0 0 1 1</ambient><diffuse>0 0 1 1</diffuse></material></visual>
        <visual name="two_tr"><pose>1.95 0.2 0 0 0 0</pose><geometry><box><size>0.08 0.18 0.001</size></box></geometry><material><ambient>0 0 1 1</ambient><diffuse>0 0 1 1</diffuse></material></visual>
        <visual name="two_bl"><pose>1.65 0.0 0 0 0 0</pose><geometry><box><size>0.08 0.18 0.001</size></box></geometry><material><ambient>0 0 1 1</ambient><diffuse>0 0 1 1</diffuse></material></visual>
      </link>
    </model>
    <include>
      <uri>model://pallet</uri>
      <name>pallet_2</name>
      <pose>-14 -3 0.01 0 0 1.5708</pose>
    </include>

    <!-- Wooden Pallet, middle back wall -->
    <!-- Pallet 3 marker -->
    <model name="pallet_3_marker">
      <static>true</static>
      <pose>-14 0 0.001 0 0 0</pose>
      <link name="link">
        <visual name="top"><pose>0 0.6 0 0 0 0</pose><geometry><box><size>1.6 0.08 0.001</size></box></geometry><material><ambient>0 0 1 1</ambient><diffuse>0 0 1 1</diffuse></material></visual>
        <visual name="bottom"><pose>0 -0.6 0 0 0 0</pose><geometry><box><size>1.6 0.08 0.001</size></box></geometry><material><ambient>0 0 1 1</ambient><diffuse>0 0 1 1</diffuse></material></visual>
