      <pose>-14 3 0.001 0 0 0</pose>
      <link name="link">
        <visual name="top"><pose>0 0.6 0 0 0 0</pose><geometry><box><size>1.6 0.08 0.001</size></box></geometry><material><ambient>0 0 1 1</ambient><diffuse>0 0 1 1</diffuse></material></visual>
        <visual name="bottom"><pose>0 -0.6 0 0 0 0</pose><geometry><box><size>1.6 0.08 0.001</size></box></geometry><material><ambient>0 0 1 1</ambient><diffuse>0 0 1 1</diffuse></material></visual>
        <visual name="left"><pose>-0.8 0 0 0 0 0</pose><geometry><box><size>0.08 1.2 0.001</size></box></geometry><material><ambient>0 0 1 1</ambient><diffuse>0 0 1 1</diffuse></material></visual>
        <visual name="right"><pose>0.8 0 0 0 0 0</pose><geometry><box><size>0.08 1.2 0.001</size></box></geometry><material><ambient>0 0 1 1</ambient><diffuse>0 0 1 1</diffuse></material></visual>
        <visual name="p_left"><pose>1.2 0.1 0 0 0 0</pose><geometry><box><size>0.08 0.6 0.001</size></box></geometry><material><ambient>0 0 1 1</ambient><diffuse>0 0 1 1</diffuse></material></visual>
        <visual name="p_top"><pose>1.35 0.3 0 0 0 0</pose><geometry><box><size>0.22 0.08 0.001</size></box></geometry><material><ambient>0 0 1 1</ambient><diffuse>0 0 1 1</diffuse></material></visual>
