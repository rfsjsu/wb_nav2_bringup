      </link>
    </model>
    <include>
      <uri>model://pallet</uri>
      <name>pallet_3</name>
      <pose>-14 0 0.01 0 0 1.5708</pose>
    </include>

    <!-- Wooden Pallet, lower back wall -->
    <!-- Pallet 4 marker -->
